# PostgreSQL Database Configuration
# Change these values according to your environment

# Database Name
DB_NAME=online_exam_system

# Database User
DB_USER=postgres

# Database Password (DO NOT COMMIT THE REAL PASSWORD TO GITHUB)
DB_PASSWORD=your_postgres_password_here

# Database Host
DB_HOST=localhost

# Database Port
DB_PORT=5432

# Django Settings
DEBUG=True

# Secret Key (DO NOT COMMIT THE REAL SECRET KEY TO GITHUB)
# Generate a new one from: https://djecrety.ir/
SECRET_KEY=your-secret-key-here-change-in-production

# For Production/Render, you can also use:
# DATABASE_URL=postgresql://user:password@host:port/dbname
